
#!/bin/sh

LOG=/run/lss-mode.log
MODEFILE=/run/lss-mode
DEVICE=/dev/mmcblk0p3

# Show status on splash screen and log
report() {
    echo "$1" >> "$LOG"
    /usr/bin/psplash-write "MSG $1" \
        2>/dev/null || true
}

# Check if mass storage module is loaded
gadget_loaded() {
    grep -q '^g_mass_storage ' /proc/modules
}

# Safely release USB storage

# Safely release USB storage
release_gadget() {
    if gadget_loaded; then

        # Remove only the mass storage module
        if command -v rmmod >/dev/null 2>&1; then
            rmmod g_mass_storage >> "$LOG" 2>&1 || true
        else
            modprobe -r g_mass_storage >> "$LOG" 2>&1 || true
        fi
    fi

    # Verify that the module is actually gone
    if gadget_loaded; then
        echo "ERROR: g_mass_storage still loaded" >> "$LOG"
        return 1
    fi

    echo "USB storage successfully released" >> "$LOG"
    return 0
}

# Enter playback only after storage is released
enter_playback() {
    if ! release_gadget; then
        report "ERROR USB RELEASE"
        return 1
    fi

    echo "playback" > "$MODEFILE"
    report "PLAYBACK MODE"
    return 0
}

# Detect USB host connection
host_detected() {
    for f in /sys/class/udc/*/state; do
        [ -r "$f" ] || continue

        case "$(cat "$f" 2>/dev/null)" in
            configured|suspended|addressed|default)
                return 0
                ;;
        esac
    done

    return 1
}

case "$1" in
    start)
        : > "$LOG"
        echo "error" > "$MODEFILE"

        report "CHECKING STORAGE"

        if [ ! -b "$DEVICE" ]; then
            report "ERROR VIDEO PARTITION"
            exit 1
        fi

        if grep -q "^$DEVICE " /proc/mounts; then
            report "ERROR VIDEO MOUNTED"
            exit 1
        fi

        report "INITIALIZING USB"

        # USB controller may be unavailable
        # when powered without a USB host
        if ! modprobe dwc2 >> "$LOG" 2>&1; then
            report "USB UNAVAILABLE"
            enter_playback || exit 1
            exit 0
        fi

        # Try to enable USB storage
        if ! modprobe g_mass_storage \
            file="$DEVICE" \
            removable=1 \
            ro=0 \
            stall=0 >> "$LOG" 2>&1; then

            report "USB UNAVAILABLE"
            enter_playback || exit 1
            exit 0
        fi

        report "WAITING FOR PC"

        # Wait up to 6 seconds
        i=0
        while [ "$i" -lt 30 ]; do
            if host_detected; then
                echo "usb" > "$MODEFILE"
                report "USB STORAGE MODE"
                exit 0
            fi

            sleep 0.2
            i=$((i + 1))
        done

        # No USB host: enter playback mode
        report "RELEASING USB"

        enter_playback || exit 1
        ;;

    stop)
        release_gadget || true
        ;;
esac

exit 0
